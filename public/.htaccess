# Apache on the web host: serve the static export's 404 page for every missing URL. The /virtualni_prohlidka/
# tour redirects its misses to /errors/404, which does not exist, so they end here too.
ErrorDocument 404 /404.html

# Group pages moved under Seznam aktivit (/aktivity/<group>/); the old site and its links use /schola.
RedirectMatch 301 ^/schola/?$ /aktivity/schola/
RedirectMatch 301 ^/chramovy_sbor/?$ /aktivity/chramovy_sbor/
RedirectMatch 301 ^/spolecenstvi_mladych(/setkavani)?/?$ /aktivity/spolecenstvi_mladych/
RedirectMatch 301 ^/katecheze_pro_deti(/pravidelne)?/?$ /aktivity/katecheze_pro_deti/
RedirectMatch 301 ^/katecheze_pro_deti/mimoradne/(.+?)/?$ /aktivity/katecheze_pro_deti/mimoradne/$1/
