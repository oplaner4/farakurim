# Apache on the web host: serve the static export's 404 page for every missing URL. The /virtualni_prohlidka/
# tour redirects its misses to /errors/404, which does not exist, so they end here too.
ErrorDocument 404 /404.html

# Files under /_next/static/ have a content hash in their name, so browsers may keep them for a year. The host's
# default (max-age=30) made every visit revalidate the fonts, and the text flashed in the fallback font meanwhile.
# Pages and their RSC payloads (*.txt, read on client-side navigation) change with every release and name its
# chunks, so browsers revalidate them on every visit (a cheap 304 when nothing changed). The host's default (2 hours
# for pages, 2 days for *.txt) kept serving old pages whose chunks a later release had replaced: ChunkLoadError.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#(/|\.html|\.txt)$#">
    Header set Cache-Control "no-cache"
  </ElseIf>
</IfModule>

# biblicky-citat.php sends its own Cache-Control (until midnight); the host's default added a second one with
# max-age=30 and an Expires header.
<Files "biblicky-citat.php">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
</Files>

# www.farakurim.cz served the same pages as farakurim.cz, so search engines saw two copies of the site (the old
# site used www). Send it to the bare host, keeping the path and query.
<If "%{HTTP_HOST} =~ /^www\./i">
  RedirectMatch 301 ^/(.*)$ https://farakurim.cz/$1
</If>

# Section folders without a page of their own open their first page (the host lists no directories, so they
# would answer 403).
RedirectMatch 301 ^/pastoracni_rada/?$ /pastoracni_rada/clenove/
RedirectMatch 301 ^/financni_podpora/?$ /financni_podpora/aktualne/
RedirectMatch 301 ^/petrklic/?$ /petrklic/aktualni/
RedirectMatch 301 ^/farni_tabor/?$ /farni_tabor/informace/
RedirectMatch 301 ^/betlemy/?$ /betlemy/rozcestnik/

# Group pages moved under Seznam aktivit (/aktivity/<group>/); the old site and its links use /schola.
RedirectMatch 301 ^/schola/?$ /aktivity/schola/
RedirectMatch 301 ^/chramovy_sbor/?$ /aktivity/chramovy_sbor/
RedirectMatch 301 ^/spolecenstvi_mladych(/setkavani)?/?$ /aktivity/spolecenstvi_mladych/
# The old katecheze pages also answered with .php.
RedirectMatch 301 ^/katecheze_pro_deti(/pravidelne)?(\.php)?/?$ /aktivity/katecheze_pro_deti/

# Mimořádné katecheze are not rebuilt: their URLs, the old ones and those under /aktivity/ that earlier releases served as
# placeholders, lead to the same page on the old site. mimoradne/ and the season folders open their rozcestník.
RedirectMatch 301 ^/(?:aktivity/)?katecheze_pro_deti/mimoradne(?:/index)?(?:\.php)?/?$ https://stary.farakurim.cz/katecheze_pro_deti/mimoradne/rozcestnik
RedirectMatch 301 ^/(?:aktivity/)?katecheze_pro_deti/mimoradne/(adventni_doba|postni_doba|vanocni_doba)(?:/index)?(?:\.php)?/?$ https://stary.farakurim.cz/katecheze_pro_deti/mimoradne/$1/rozcestnik
RedirectMatch 301 ^/(?:aktivity/)?katecheze_pro_deti/mimoradne/(.+?)(?:\.php)?/?$ https://stary.farakurim.cz/katecheze_pro_deti/mimoradne/$1
