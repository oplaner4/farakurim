# Copy to .env.local (never committed) and fill in. Next.js loads it for `pnpm dev` and `pnpm build`.

# Google Calendar API key for the Kalendář page and the homepage week calendar (design/DESIGN.md §16.4).
# It is inlined into the published JavaScript, so restrict it in Google Cloud to the farakurim.cz referrer
# (add localhost for live data during development) and to the Google Calendar API.
# Leave empty to use mock calendars generated from the mass schedule and the Aktuality records.
NEXT_PUBLIC_GOOGLE_CALENDAR_API_KEY=

# Anonymous statistics (self-hosted Matomo, no cookies). Leave empty locally so development visits are not counted;
# set both to test the tracker against the real instance.
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=
